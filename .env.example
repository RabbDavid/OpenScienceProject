HOST=127.0.0.1
PORT=4310
DATABASE_PATH=./data/commons.sqlite
# Vercel requires these instead of a local DATABASE_PATH. Never prefix secrets with VITE_.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-private-database-token
# Only set TRUST_PROXY=1 behind exactly one trusted reverse proxy.
TRUST_PROXY=0
# PRIVATE_READS=1 requires a bearer key for API reads. Static pages need separate deployment protection.
PRIVATE_READS=0
