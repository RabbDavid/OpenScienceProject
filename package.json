{
  "name": "openscience-commons",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    }
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build && tsx scripts/build-manifest.ts",
    "start": "tsx server/index.ts --production",
    "test": "tsx --test tests/*.test.ts",
    "probe:agent": "tsx scripts/probe-agent.ts",
    "check": "npm run build && npm test",
    "key:create": "tsx scripts/create-key.ts",
    "key:revoke": "tsx scripts/revoke-key.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "literature": "tsx scripts/collect-literature.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.23.15",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vercel/routing-utils": "^6.6.0",
    "@vitejs/plugin-react": "^6.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  }
}
