{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["dub1"],
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index" }],
  "functions": {
    "api/index.ts": { "maxDuration": 60, "includeFiles": "server/literature.json" }
  }
}
